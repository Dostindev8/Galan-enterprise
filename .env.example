# Public site origin used for canonical URLs, OG tags, and Origin checks.
# Example: https://galanoperations.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number in E.164 digits only (no + or spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=16892530469

# Optional. If empty, the Instagram icon is hidden.
# Example: https://www.instagram.com/galanoperations/
NEXT_PUBLIC_INSTAGRAM_URL=

# Resend API key — server only. Never expose to the client.
# https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact + apply form notifications.
CONTACT_TO_EMAIL=hello@example.com

# From address must be a verified Resend domain/sender.
CONTACT_FROM_EMAIL=Galan Operations <noreply@example.com>

# Optional Upstash Redis — if omitted, an in-memory Map() limiter is used.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
